# Build settings read by scripts/build-app.sh. Copy to .env and adjust.

# Code signing identity. "-" = ad-hoc (local use only; macOS asks for audio
# permission again after every rebuild). Use your "Developer ID Application: …"
# identity to sign with the hardened runtime.
CODESIGN_IDENTITY=-

# Bundle identifier of the built app.
BUNDLE_ID=com.example.overtone

# Marketing version shown in About.
VERSION=1.0.0

# 1 = build a universal (arm64 + x86_64) binary.
UNIVERSAL=0
